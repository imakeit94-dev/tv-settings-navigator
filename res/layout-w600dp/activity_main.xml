<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="30dp"
        android:paddingEnd="56dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/warning_bg"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="@string/warning"
            android:textColor="@color/warning"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_development"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:background="@drawable/btn_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/btn_settings"
                android:nextFocusRight="@+id/btn_device_info"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/btn_development"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn_device_info"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:background="@drawable/btn_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/btn_wireless"
                android:nextFocusLeft="@+id/btn_development"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/btn_device_info"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:background="@drawable/btn_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@+id/btn_wireless"
                android:nextFocusUp="@+id/btn_development"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/btn_settings"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn_wireless"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:background="@drawable/btn_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@+id/btn_settings"
                android:nextFocusUp="@+id/btn_device_info"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/btn_wireless"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/status_bg"
            android:minHeight="68dp"
            android:padding="16dp"
            android:text="@string/status_idle"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
