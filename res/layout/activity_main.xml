<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/warning_bg"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="@string/warning"
            android:textColor="@color/warning"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_development"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/btn_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/btn_device_info"
            android:text="@string/btn_development"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_device_info"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/btn_settings"
            android:nextFocusUp="@+id/btn_development"
            android:text="@string/btn_device_info"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/btn_wireless"
            android:nextFocusUp="@+id/btn_device_info"
            android:text="@string/btn_settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_wireless"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@+id/btn_settings"
            android:text="@string/btn_wireless"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/status_bg"
            android:minHeight="68dp"
            android:padding="16dp"
            android:text="@string/status_idle"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
